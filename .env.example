# Skopiuj do .env.local i uzupełnij. NIGDY nie commituj wypełnionego pliku.
# Produkcja: wartości wstrzykiwane przez SOPS/age przy starcie, nie w obrazie Dockera.

# ── Web (apps/web) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:8787

# Lokalnie: kontenery z infra/docker-compose.yml.
# Na VPS: hosty z sieci wewnętrznej Compose (postgres / redis), porty nie wychodzą na hosta.
DATABASE_URL=postgres://sub:sub@localhost:5432/sub
REDIS_URL=redis://localhost:6379

# Sól do hashowania adresów IP. Surowe adresy nie trafiają nigdzie.
IP_HASH_SALT=

# Better Auth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session JWT wydawany dla relay (EdDSA, Ed25519)
SESSION_JWT_PRIVATE_KEY=
SESSION_JWT_PUBLIC_KEY=

# Poczta transakcyjna
SMTP_URL=
MAIL_FROM=noreply@sub.hexart.io

# ── Paddle ────────────────────────────────────────────────────────────────────
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Mapa: priceId:kind:credits[:planCode], po przecinku. Sandbox i produkcja mają
# różne identyfikatory, więc katalog siedzi w env, nie w kodzie.
# PADDLE_CATALOG="pri_a:subscription:300:starter,pri_b:subscription:1000:creator,pri_c:topup:1000"
PADDLE_CATALOG=

# Wersja regulaminu zapisywana przy zgodzie z art. 38 pkt 13.
TERMS_VERSION=2026-08-08

# ── Relay (apps/relay) — SERVER ONLY, nigdy w bundlu klienckim ────────────────
RELAY_PORT=8787
SESSION_JWT_PUBLIC_KEY_RELAY=

# ElevenLabs — osobne klucze per środowisko i per pipeline
ELEVENLABS_API_KEY_STT=
ELEVENLABS_API_KEY_TTS=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_REGION=eu

# OpenRouter — klucz zarządzający tworzy klucze runtime per użytkownik
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_QUALITY=

# Szyfrowanie kluczy runtime w bazie (AES-256-GCM, base64, 32 B)
PROVIDER_KEY_ENC_KEY=
PROVIDER_KEY_ENC_VERSION=1

# ── Obserwowalność ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
