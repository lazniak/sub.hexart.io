# Next.js standalone image for apps/web.
#
# Build context is the repository root:
#   docker build -f infra/Dockerfile.web --target runtime .
#
# The ignore rules come from infra/Dockerfile.web.dockerignore — BuildKit
# resolves an ignore file sitting next to the Dockerfile before falling back to
# one at the context root.

# ── Base: one place that fixes the toolchain ──────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1
# Corepack reads the pinned pnpm version from the root package.json, so the
# image can never drift from what CI and developers use.
RUN corepack enable
WORKDIR /app

# ── Fetch: the only layer that touches the network for packages ───────────────
# `pnpm fetch` needs the lockfile alone. Application source changes therefore do
# not invalidate the dependency download.
FROM base AS fetch
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# ── Build: full workspace install, then the Next production build ─────────────
FROM fetch AS build
COPY . .
RUN pnpm install --frozen-lockfile --offline

# NEXT_PUBLIC_* values are inlined into the client bundle, so they have to be
# known at build time. Nothing secret may be passed here: build args are
# readable from the finished image's history.
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_RELAY_WS_URL
ARG NEXT_PUBLIC_PADDLE_CLIENT_TOKEN
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_RELAY_WS_URL=$NEXT_PUBLIC_RELAY_WS_URL \
    NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=$NEXT_PUBLIC_PADDLE_CLIENT_TOKEN \
    NODE_ENV=production \
    NEXT_OUTPUT=standalone

RUN pnpm --filter @sub/web... build

# ── Migrator: drizzle-kit needs the dev dependency tree, the runtime does not ─
# One-shot job on the internal network with no listening port, so it stays root:
# dropping privileges here would only mean chowning the build tree for nothing.
FROM build AS migrator
WORKDIR /app/packages/db
CMD ["pnpm", "exec", "drizzle-kit", "migrate"]

# ── Runtime: standalone output only ───────────────────────────────────────────
FROM node:22-alpine AS runtime
# tini reaps zombies and, more importantly, gives PID 1 a default SIGTERM
# action so `docker stop` actually stops the server instead of waiting out the
# grace period.
RUN apk add --no-cache tini
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app

# `next build` with output: 'standalone' emits the server plus the exact subset
# of node_modules it needs. Static assets and public/ are not included and have
# to be placed where the standalone server expects them.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public

# ISR writes here at runtime; the rest of the tree stays read-only to `node`.
RUN mkdir -p /app/apps/web/.next/cache && chown -R node:node /app/apps/web/.next/cache

USER node
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "-g", "--"]
CMD ["node", "apps/web/server.js"]
